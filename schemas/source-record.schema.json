{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/osint-source-registry/blob/main/schemas/source-record.schema.json",
  "title": "OSINT Source Record",
  "type": "object",
  "required": [
    "source_id",
    "name",
    "source_type",
    "operator",
    "canonical_url",
    "jurisdiction",
    "access_method",
    "access_auth",
    "data_sensitivity",
    "robots_policy",
    "collection_constraints",
    "permitted_purposes",
    "prohibited_purposes",
    "declared_rate_limit_per_minute",
    "retention_days",
    "review_status"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 200},
    "source_type": {"enum": ["website", "public_api", "dataset", "publication", "document_repository", "public_registry"]},
    "operator": {"type": "string", "minLength": 2, "maxLength": 200},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "jurisdiction": {"type": "string", "minLength": 2, "maxLength": 120},
    "access_method": {"enum": ["public_web", "public_api", "downloadable_dataset", "manual_review"]},
    "access_auth": {"enum": ["none", "api_key_required", "oauth_required", "account_required", "unknown"]},
    "terms_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "license_expression": {"type": ["string", "null"], "maxLength": 120},
    "data_sensitivity": {"enum": ["public", "personal_data_possible", "sensitive_personal_data", "unknown"]},
    "robots_policy": {"enum": ["respect", "manual_review_required", "not_applicable", "unknown"]},
    "collection_constraints": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 3, "maxLength": 500}},
    "permitted_purposes": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 2, "maxLength": 100}},
    "prohibited_purposes": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 2, "maxLength": 100}},
    "declared_rate_limit_per_minute": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
    "retention_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 36500},
    "review_status": {"enum": ["pending", "approved", "suspended", "rejected", "retired"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "review_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "review_notes": {"type": "string", "maxLength": 1000}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "approved"}}, "required": ["review_status"]},
      "then": {
        "required": ["terms_url", "license_expression", "reviewed_at", "review_expires_at"],
        "properties": {
          "terms_url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
          "license_expression": {"type": "string", "minLength": 1},
          "permitted_purposes": {"type": "array", "minItems": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "review_expires_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}
